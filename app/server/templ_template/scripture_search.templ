package templ_template

import (
	"fmt"
	"github.com/mahesh-hegde/dhee/app/excerpts"
	"strings"
)

templ ScriptureSearch(data *excerpts.ExcerptSearchData) {
	<div class="container">
		<style>
			@media (max-width: 767.98px) {
				#search-results-table,
				#search-results-table thead,
				#search-results-table tbody,
				#search-results-table tr,
				#search-results-table td {
					width: 100% !important;
					max-width: 100% !important;
					display: block !important;
				}
				#search-results-table thead {
					display: none !important;
				}
				#search-results-table tr {
					border: 1px solid var(--bs-border-color);
					margin-bottom: 1rem;
					border-radius: 0.25rem;
					background-color: var(--bs-body-bg);
					page-break-inside: avoid;
					break-inside: avoid;
				}
				#search-results-table tbody tr:nth-child(odd) {
					background-color: var(--bs-body-bg);
				}
				#search-results-table tbody tr:nth-child(even) {
					background-color: var(--bs-body-bg);
				}
				#search-results-table td {
					text-align: left;
					padding: 0.75rem !important;
					border-bottom: 1px solid var(--bs-border-color) !important;
					word-wrap: break-word;
					overflow-wrap: break-word;
				}
				#search-results-table td:last-child {
					border-bottom: none !important;
				}
				#search-results-table td pre {
					width: 100%;
					max-width: 100%;
					white-space: pre-wrap;
					word-break: break-word;
					margin: 0;
				}
				#search-results-table td::before {
					content: attr(data-label);
					font-weight: 600;
					display: block;
					font-size: 0.875rem;
					color: #666;
					margin-bottom: 0.25rem;
				}
			}
		</style>
		<div class="row my-3">
			<div class="col-lg-6 offset-lg-6" style="font-size: 0.7em;">
				@ScriptureSearchWidget(data.Scripture, &data.Search, true)
			</div>
		</div>
		<h2 class="my-4">Search Results for { fmt.Sprintf("%q", data.Search.Q) }</h2>
		if data.Excerpts != nil && len(data.Excerpts) > 0 {
			<div class="table-responsive">
				<table id="search-results-table" class="table table-striped search-result">
					<thead>
						<tr>
							<th scope="col">#</th>
							<th scope="col">Path</th>
							<th scope="col">Roman Text</th>
							<th scope="col">
								if data.Scripture.TranslationAuxiliary != "" {
									Translation ({ data.Scripture.TranslationAuxiliary })
								} else {
									Translation
								}
							</th>
							<th scope="col">Addressee</th>
						</tr>
					</thead>
					<tbody>
						for i, hExcerpt := range data.Excerpts {
							{{ var excerpt = hExcerpt.Excerpt }}
							<tr>
								<td data-label="#">{ fmt.Sprintf("%d", i+1) }</td>
								<td data-label="Path"><a href={ templ.URL(fmt.Sprintf("/scriptures/%s/excerpts/%s", excerpt.Scripture, excerpt.ReadableIndex)) }>{ excerpt.ReadableIndex }</a></td>
								<td class="roman-text-search" data-label="Roman Text">
									if hExcerpt.RomanHl != "" {
										<pre>
											@templ.Raw(hExcerpt.RomanHl)
										</pre>
									} else {
										<pre>
											for _, line := range excerpt.RomanText {
												{ line + "\n" }
											}
										</pre>
									}
								</td>
								<td class="wrap-50 translation-col" data-label="Translation">
									if hExcerpt.TranslationHl != "" {
										@templ.Raw(hExcerpt.TranslationHl)
									} else if data.Scripture.TranslationAuxiliary != "" {
										if aux, ok := excerpt.Auxiliaries[data.Scripture.TranslationAuxiliary]; ok {
											for _, text := range aux.Text {
												{ text }
											}
										}
									}
								</td>
								<td data-label="Addressee">{ strings.Join(excerpt.Addressees, ", ") }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			<div class="alert alert-warning" role="alert">
				No results found!
			</div>
		}
	</div>
	@SearchScript()
	@SelectionSearchScript()
	<script>
		var preInit = preInit || [];
        preInit.push(function() {
            if (window.dhee && window.dhee.setupTextSelectionSearch) {
                window.dhee.setupTextSelectionSearch('search-results-table', 'iast', 3);
            }
            document.querySelectorAll('.translation-col').forEach(function(el) {
                el.addEventListener('mouseup', function(e) {
                    e.stopPropagation();
                });
            });
        });
	</script>
}
